{
  "name": "blossom-carousel",
  "version": "1.0.0",
  "private": true,
  "author": "Jesper Vos",
  "license": "MIT",
  "description": "A native-scroll-first carousel component for the web.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jespervos/blossom-carousel"
  },
  "bugs": {
    "url": "https://github.com/jespervos/blossom-carousel/issues"
  },
  "homepage": "https://www.blossom-carousel.com",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run packages/core/src",
    "dev": "pnpm --filter @blossom-carousel/vue dev",
    "dev:vue": "pnpm --filter @blossom-carousel/vue dev",
    "dev:react": "pnpm --filter @blossom-carousel/react dev",
    "dev:svelte": "pnpm --filter @blossom-carousel/svelte dev",
    "dev:web": "pnpm --filter @blossom-carousel/web dev",
    "publish:framework": "pnpm -r publish --filter '@blossom-carousel/vue' --filter '@blossom-carousel/react' --filter '@blossom-carousel/svelte' --filter '@blossom-carousel/web' --access public --no-git-checks"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "esbuild@<0.28.1": "^0.28.1",
      "postcss@<=8.5.22": "8.5.23",
      "fast-uri@<3.1.8": "3.1.8",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "devalue@<5.9.3": "^5.9.3",
      "source-map-js@<1.2.2": "^1.2.2",
      "vue@<3.5.42": "^3.5.42"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "turbo": "^2.10.12",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
