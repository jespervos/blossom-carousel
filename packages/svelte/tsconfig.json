{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*", "test/**/*", "dev/**/*", "types/**/*", "scripts/**/*"]
}
