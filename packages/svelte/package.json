{
  "name": "@blossom-carousel/svelte",
  "version": "2.1.1",
  "author": "Jesper Vos",
  "license": "MIT",
  "description": "A native-scroll-first carousel component for Svelte.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jespervos/blossom-carousel"
  },
  "bugs": {
    "url": "https://github.com/jespervos/blossom-carousel/issues"
  },
  "homepage": "https://www.blossom-carousel.com",
  "keywords": [
    "blossom",
    "carousel",
    "slider",
    "slideshow",
    "scroll",
    "scroller",
    "drag",
    "dragging",
    "js",
    "vanilla",
    "javascript",
    "typescript",
    "web",
    "html",
    "css",
    "svelte",
    "react",
    "vue"
  ],
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "browser": {
    "./dist/ssrSlideCount.js": "./dist/ssrSlideCount.client.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@blossom-carousel/core": "^1.1.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && svelte-package --input src --output dist --tsconfig tsconfig.build.json && node scripts/vendorNavigation.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@blossom-carousel/navigation": "workspace:*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.55.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
