{
  "name": "@blossom-carousel/core",
  "version": "1.2.0",
  "author": "Jesper Vos",
  "license": "MIT",
  "description": "A native-scroll-first carousel component for the web.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jespervos/blossom-carousel"
  },
  "bugs": {
    "url": "https://github.com/jespervos/blossom-carousel/issues"
  },
  "homepage": "https://www.blossom-carousel.com",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "dist/blossom-carousel-core.umd.cjs",
  "module": "dist/blossom-carousel-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/blossom-carousel-core.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/blossom-carousel-core.umd.cjs"
      }
    },
    "./style.css": "./dist/blossom-carousel-core.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.1",
    "tsup": "^8.5.1",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "dependencies": {
    "@bramus/style-observer": "^2.0.2"
  }
}
